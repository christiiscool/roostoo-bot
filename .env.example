ROOSTOO_API_KEY=
ROOSTOO_SECRET_KEY=
ROOSTOO_BASE_URL=https://mock-api.roostoo.com
TRADE_PAIRS=BTC/USD,ETH/USD,BNB/USD,SOL/USD
MAX_POSITION_PCT=0.20
MAX_DRAWDOWN=0.15
COOLDOWN_SECONDS=300
TICK_INTERVAL_SECONDS=60
# Set to false only when ready to trade with competition keys
DRY_RUN=true
# true = simulate only, false = live trading
# DEBUG for verbose, INFO for normal, WARNING for quiet
LOG_LEVEL=INFO
# log output file path
LOG_FILE=bot.log
